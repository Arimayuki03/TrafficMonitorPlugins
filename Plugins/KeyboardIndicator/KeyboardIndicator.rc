    DEFPUSHBUTTON   "确定",IDOK,70,244,50,14
    PUSHBUTTON      "取消",IDCANCEL,130,244,50,14
END

IDD_DISPLAY_PAGE DIALOGEX 0, 0, 224, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "微软雅黑", 400, 0, 0x0
BEGIN
    CONTROL         "显示 Caps Lock",IDC_SHOW_CAPS_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,8,208,12
    CONTROL         "显示 Num Lock",IDC_SHOW_NUM_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,24,208,12
    CONTROL         "显示 Scroll Lock",IDC_SHOW_SCROLL_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,40,208,12
    CONTROL         "使用圆角矩形边框",IDC_DRAW_ROUND_RECT_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,56,208,12
    CONTROL         "显示按下的按键",IDC_SHOW_PRESSED_KEY_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,72,208,12
    LTEXT           "按键松开后显示时长(毫秒):",IDC_STATIC,8,93,104,12
    EDITTEXT        IDC_PRESSED_KEY_SHOW_TIME_EDIT,116,90,44,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "按键区最小宽度:",IDC_STATIC,8,111,104,12
    EDITTEXT        IDC_PRESSED_KEY_RESERVED_EDIT,116,108,44,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    GROUPBOX        "累计计数显示",IDC_STATIC,8,128,208,44
    CONTROL         "在任务栏显示累计计数",IDC_SHOW_KEY_COUNT_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,141,96,12
    LTEXT           "计数区最小宽度:",IDC_STATIC,114,143,72,12
    EDITTEXT        IDC_KEY_COUNT_RESERVED_EDIT,188,140,22,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    CONTROL         "计数旁显示当前KPM",IDC_SHOW_KPM_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,157,96,12
    LTEXT           "KPM区最小宽度:",IDC_STATIC,114,159,72,12
    EDITTEXT        IDC_KPM_RESERVED_EDIT,188,156,22,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "宽度为区域的最小宽度：至少保持该宽度以避免任务栏抖动；\r\n0 = 按内容自适应。达到每日目标的计数显示为绿色。",IDC_STATIC,8,176,218,24
END

IDD_STATS_PAGE DIALOGEX 0, 0, 224, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "微软雅黑", 400, 0, 0x0
BEGIN
    CONTROL         "启用按键统计",IDC_ENABLE_KEY_STATS_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,8,100,12
    LTEXT           "每日目标(0不启用):",IDC_STATIC,112,10,74,12
    EDITTEXT        IDC_DAILY_GOAL_EDIT,188,8,32,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "",IDC_STATS_SUMMARY,8,26,118,20
    COMBOBOX        IDC_STATS_RANGE_COMBO,128,28,46,80,CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "刷新",IDC_STATS_REFRESH_BUTTON,86,50,34,14
    CONTROL         "",IDC_STATS_TAB,"SysTabControl32",0x50010000,8,64,208,130
    PUSHBUTTON      "清零",IDC_RESET_STATS_BUTTON,8,50,36,14
    PUSHBUTTON      "导出CSV",IDC_EXPORT_CSV_BUTTON,46,50,38,14
    CONTROL         "",IDC_KEYBOARD_MAP_CTRL,"Static",SS_OWNERDRAW | SS_NOTIFY | WS_CHILD,14,58,196,28
    CONTROL         "",IDC_RANK_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,14,90,196,98
    CONTROL         "",IDC_HISTORY_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER,14,90,196,98
    CONTROL         "",IDC_CHART_CTRL,"Static",SS_OWNERDRAW | WS_CHILD,14,90,196,98
END

IDD_DISPLAY_ITEMS_PAGE DIALOGEX 0, 0, 224, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "微软雅黑", 400, 0, 0x0
BEGIN
    LTEXT           "用上移/下移调整顺序，双击一行可直接设置该显示项的颜色。",IDC_STATIC,8,6,208,12
    CONTROL         "",IDC_ITEM_ORDER_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,8,20,208,112
    PUSHBUTTON      "上移",IDC_ITEM_ORDER_UP_BUTTON,8,138,40,14
    PUSHBUTTON      "下移",IDC_ITEM_ORDER_DOWN_BUTTON,52,138,40,14
    PUSHBUTTON      "设置颜色...",IDC_ITEM_COLOR_BUTTON,96,138,60,14
    PUSHBUTTON      "恢复默认色",IDC_ITEM_COLOR_RESET_BUTTON,160,138,56,14
    LTEXT           "颜色用于点亮状态：未开启的锁定键、已松开的按键仍为灰色。\r\n标注「已隐藏」的项目不在任务栏显示(见「显示设置」页)。",IDC_STATIC,8,158,208,24
END


