IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 250, 260
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keyboard Indicator Settings"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "Tab1",IDC_MAIN_TAB,"SysTabControl32",0x50010000,6,6,238,240
    DEFPUSHBUTTON   "OK",IDOK,75,244,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,135,244,50,14
END

IDD_DISPLAY_PAGE DIALOGEX 0, 0, 234, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "Show Caps Lock",IDC_SHOW_CAPS_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,8,218,12
    CONTROL         "Show Num Lock",IDC_SHOW_NUM_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,24,218,12
    CONTROL         "Show Scroll Lock",IDC_SHOW_SCROLL_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,40,218,12
    CONTROL         "Use rounded rectangle borders",IDC_DRAW_ROUND_RECT_CHECK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,56,218,12
    CONTROL         "Show pressed keys",IDC_SHOW_PRESSED_KEY_CHECK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,72,218,12
    LTEXT           "Show time after key release (ms):",IDC_STATIC,8,93,114,12
    EDITTEXT        IDC_PRESSED_KEY_SHOW_TIME_EDIT,126,90,44,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "Min key area width:",IDC_STATIC,8,111,114,12
    EDITTEXT        IDC_PRESSED_KEY_RESERVED_EDIT,126,108,44,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    GROUPBOX        "Total count display",IDC_STATIC,8,128,218,44
    CONTROL         "Show total count on taskbar",IDC_SHOW_KEY_COUNT_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,141,116,12
    LTEXT           "Min count width:",IDC_STATIC,114,143,72,12
    EDITTEXT        IDC_KEY_COUNT_RESERVED_EDIT,188,140,22,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    CONTROL         "Show current KPM beside count",IDC_SHOW_KPM_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,157,116,12
    LTEXT           "Min KPM width:",IDC_STATIC,114,159,72,12
    EDITTEXT        IDC_KPM_RESERVED_EDIT,188,156,22,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "A width is the minimum width of that area: the area keeps at least this width so the taskbar width does not jitter;\r\n0 = fit the content. The count turns green when the daily goal is reached.",IDC_STATIC,8,176,218,24
END

IDD_STATS_PAGE DIALOGEX 0, 0, 234, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "Enable key statistics",IDC_ENABLE_KEY_STATS_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,8,104,12
    LTEXT           "Daily goal (0=off):",IDC_STATIC,116,10,70,12
    EDITTEXT        IDC_DAILY_GOAL_EDIT,188,8,32,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "",IDC_STATS_SUMMARY,8,26,118,20
    COMBOBOX        IDC_STATS_RANGE_COMBO,128,28,46,80,CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "Refresh",IDC_STATS_REFRESH_BUTTON,104,50,42,14
    CONTROL         "",IDC_STATS_TAB,"SysTabControl32",0x50010000,8,64,218,130
    PUSHBUTTON      "Reset",IDC_RESET_STATS_BUTTON,8,50,40,14
    PUSHBUTTON      "Export CSV",IDC_EXPORT_CSV_BUTTON,50,50,52,14
    CONTROL         "",IDC_KEYBOARD_MAP_CTRL,"Static",SS_OWNERDRAW | SS_NOTIFY | WS_CHILD,14,58,206,28
    CONTROL         "",IDC_RANK_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,14,90,206,98
    CONTROL         "",IDC_HISTORY_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER,14,90,206,98
    CONTROL         "",IDC_CHART_CTRL,"Static",SS_OWNERDRAW | WS_CHILD,14,90,206,98
END

IDD_DISPLAY_ITEMS_PAGE DIALOGEX 0, 0, 234, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Use Up/Down to change the order; double-click a row to set its color.",IDC_STATIC,8,6,218,12
    CONTROL         "",IDC_ITEM_ORDER_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,8,20,218,112
    PUSHBUTTON      "Up",IDC_ITEM_ORDER_UP_BUTTON,8,138,40,14
    PUSHBUTTON      "Down",IDC_ITEM_ORDER_DOWN_BUTTON,52,138,40,14
    PUSHBUTTON      "Set color...",IDC_ITEM_COLOR_BUTTON,96,138,60,14
    PUSHBUTTON      "Reset color",IDC_ITEM_COLOR_RESET_BUTTON,160,138,58,14
    LTEXT           "Colors apply to the active state; a switched-off lock key or a released key stays gray.\r\nRows marked (hidden) are not shown on the taskbar (see the Display page).",IDC_STATIC,8,158,218,24
END


