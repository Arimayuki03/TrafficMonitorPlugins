IDD_DISPLAY_PAGE DIALOGEX 0, 0, 234, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "Show Caps Lock",IDC_SHOW_CAPS_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,8,218,12
    CONTROL         "Show Num Lock",IDC_SHOW_NUM_LOCK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,24,218,12
