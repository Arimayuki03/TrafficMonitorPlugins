    LTEXT           "KPM width (0=auto):",IDC_STATIC,114,159,72,12
    EDITTEXT        IDC_KPM_RESERVED_EDIT,188,156,22,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
