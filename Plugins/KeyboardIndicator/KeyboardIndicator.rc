    LTEXT           "Count width (0=auto):",IDC_STATIC,114,143,72,12
    EDITTEXT        IDC_KEY_COUNT_RESERVED_EDIT,188,140,22,14,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
