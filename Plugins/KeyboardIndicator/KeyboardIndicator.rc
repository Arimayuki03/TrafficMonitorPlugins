                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,56,218,12
    CONTROL         "Show pressed keys",IDC_SHOW_PRESSED_KEY_CHECK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,72,218,12
